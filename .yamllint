---
extends: default

ignore: |
  .github/stale.yml
  README.md
  LICENSE
  ansible.cfg

rules:
  line-length:
    max: 120
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
...
